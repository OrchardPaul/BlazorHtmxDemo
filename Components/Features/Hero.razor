<section class="relative min-h-screen flex items-center justify-center bg-gradient-to-b from-base-100 to-base-300">
    <div class="container mx-auto px-4 py-20 ">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="space-y-8">
                <div class="space-y-4">
                    <div class="flex items-center gap-2 text-primarycol">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="h-5 w-5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                        </svg>

                        <span class="text-sm font-medium">Personal Branding & Marketing</span>
                    </div>
                    <h1 class="text-5xl lg:text-6xl font-bold tracking-tight">
                        <span class="text-primarycol">
                            Rosie Taylor
                        </span>
                        <br />
                        <span class="text-foreground">Branding</span>
                    </h1>
                    <p class="text-xl text-muted-foreground leading-relaxed">
                        Creating meaningful brand identities for small businesses across the UK.
                        I take the time to understand your vision and craft a brand that truly represents your values.
                    </p>
                </div>

                <div class="flex flex-col sm:flex-row gap-4">
                    <button
                        class="d-btn bg-gradient-to-r from-primarycol from-[30%] via-secondarycol via-[60%] to-primarycol to-[90%] border-secondarycol">
                        Start Your Brand Journey
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="ml-2 h-4 w-4 group-hover:translate-x-1 transition-transform">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                    </button>
                    <button class="d-btn btn-outline btn-secondarycol text-secondarycol border-secondarycol">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="mr-2 h-4 w-4">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                        </svg>
                        View Portfolio
                    </button>
                </div>

                <div class="flex items-center gap-8 pt-8">
                    <div class="text-center">
                        <div class="text-2xl font-bold text-primarycol">50+</div>
                        <div class="text-sm text-muted-foreground">Happy Clients</div>
                    </div>
                    <div class="text-center">
                        <div class="text-2xl font-bold text-secondarycol">5 Years</div>
                        <div class="text-sm text-muted-foreground">Experience</div>
                    </div>
                    <div class="text-center">
                        <div class="text-2xl font-bold text-primarycol">UK Wide</div>
                        <div class="text-sm text-muted-foreground">Coverage</div>
                    </div>
                </div>
            </div>

            <div class="relative">
                <div class="relative z-10">
                    <!-- Portfolio Carousel -->
                    <div
                        class="w-full h-[30rem] bg-gradient-to-br from-primarycol/20 to-secondarycol/20 rounded-2xl shadow-[0_0_20px_5px] shadow-primarycol dark:shadow-primarycol overflow-hidden group">
                        <div id="heroCarousel" class="d-carousel w-full h-full rounded-2xl">
                            @foreach (dynamic slide in portfolioSlides)
                            {
                                int slideIndex = (int)slide.Index;
                                int nextIndex = slideIndex == portfolioSlides.Length ? 1 : slideIndex + 1;
                                int prevIndex = slideIndex == 1 ? portfolioSlides.Length : slideIndex - 1;
                                <div id="@($"slide{slide.Index}")" class="d-carousel-item relative w-full h-full">
                                    <img src="@slide.ImageUrl" alt="Portfolio Image 1" class="w-full h-full object-cover" />
                                    <div
                                        class="rounded-xl slide-info bg-black absolute justify-between transform translate-x-[12%] top-4 h-auto w-[80%] p-4 text-white auto-hide">
                                        <div class="flex flex-col">
                                            <span class="font-bold text-lg">@slide.Title</span>
                                            <span class="text-sm">@slide.Description</span>
                                        </div>
                                        <div class="pt-2">
                                            <a href="@slide.LinkUrl"
                                                class="text-white text-sm underline">@slide.LinkText</a>
                                        </div>
                                    </div>
                                    <div
                                        class="absolute flex justify-between transform -translate-y-1/2 left-5 right-5 top-1/2">
                                        <button onclick="showSlide(@prevIndex, true)"
                                            class="d-btn d-btn-circle bg-black/50 border-none text-white hover:bg-black/70">❮</button>
                                        <button onclick="showSlide(@nextIndex, true)"
                                            class="d-btn d-btn-circle bg-black/50 border-none text-white hover:bg-black/70">❯</button>
                                    </div>
                                </div>
                            }

                        </div>
                        <!-- Carousel indicators -->
                        <div id="carouselIndicators"
                            class="flex justify-center w-full py-2 gap-2 absolute bottom-4 left-1/2 transform -translate-x-1/2">
                            @for(int slideNo = 1; slideNo <= portfolioSlides.Length; slideNo++)
                            {
                                <button onclick="showSlide(@slideNo, true)" id="indicator-@slideNo"
                                    class="@(slideNo == 1 ? "bg-white" : "bg-white/50") carousel-indicator d-btn d-btn-xs text-black border-none hover:bg-white/80">@slideNo</button>
                            }
                                
                        </div>
                    </div>

                    <style>
                        .slide-info.auto-show {
                            opacity: 0.65 !important;
                            transition: opacity 0.5s ease;
                            pointer-events: auto;
                        }
                        .slide-info.auto-hide {
                            opacity: 0 !important;
                            transition: opacity 0.5s ease;
                            pointer-events: none;
                        }
                        .slide-info {
                            opacity: 0 !important;
                        }
                        .group:hover .slide-info {
                            pointer-events: auto;
                            opacity: 0.65 !important;
                        }
                        .group:hover .slide-info:hover {
                            opacity: 1 !important;
                            transition: opacity 0.2s ease;
                        }
                    </style>
                    <script>
                        let carouselTimer;
                        let currentSlide = 1;
                        let totalSlides = 1; // Will be calculated dynamically
                        let autoAdvanceEnabled = true;
                        let timerRunning = false;

                        function showSlideInfo(slideNumber) {
                            // Hide all slide info panels first
                            const allSlideInfos = document.querySelectorAll('.slide-info');
                            allSlideInfos.forEach(info => {
                                info.classList.remove('auto-show');
                                info.classList.add('auto-hide');
                            });

                            // Show the specific slide's info panel
                            const currentSlide = document.getElementById('slide' + slideNumber);
                            if (currentSlide) {
                                const slideInfo = currentSlide.querySelector('.slide-info');
                                if (slideInfo) {
                                    slideInfo.classList.remove('auto-hide');
                                    slideInfo.classList.add('auto-show');
                                }
                            }

                            setTimeout(() => {
                                hideSlideInfo(slideNumber);
                            }, 5000); // 3 second delay
                        }

                        function hideSlideInfo(slideNumber) {
                            const currentSlide = document.getElementById('slide' + slideNumber);
                            if (currentSlide) {
                                const slideInfo = currentSlide.querySelector('.slide-info');
                                if (slideInfo) {
                                    slideInfo.classList.remove('auto-show');
                                    slideInfo.classList.add('auto-hide');
                                }
                            }
                        }

                        function showSlide(slideNumber, isManual = false) {
                            const carousel = document.getElementById('heroCarousel');
                            const slide = document.getElementById('slide' + slideNumber);
                            const carouselIndicators = document.getElementById('carouselIndicators');
                            const indicator = document.getElementById('indicator-' + slideNumber);

                            if (carousel && slide) {
                                // Update current slide
                                currentSlide = slideNumber;

                                // If user manually navigated, stop auto-advance
                                if (isManual) {
                                    stopCarouselTimer();
                                    autoAdvanceEnabled = false;
                                }

                                // Remove active styling from all indicators
                                const allIndicators = carouselIndicators.querySelectorAll('.carousel-indicator');
                                allIndicators.forEach(i => {
                                    i.classList.remove('bg-white');
                                    i.classList.add('bg-white/50');
                                });
                                
                                // Add active styling to current indicator
                                if (indicator) {
                                    indicator.classList.remove('bg-white/50');
                                    indicator.classList.add('bg-white');
                                }
                                
                                slide.scrollIntoView({
                                    behavior: 'smooth',
                                    block: 'nearest',
                                    inline: 'start'
                                });

                                if(!isManual) {
                                    setTimeout(() => {
                                        showSlideInfo(slideNumber);
                                    }, 2000); // 2 second delay
                                }
                            }
                        }

                        function nextSlide() {
                            const next = currentSlide === totalSlides ? 1 : currentSlide + 1;
                            showSlide(next, false);
                        }

                        function startCarouselTimer() {
                            if (autoAdvanceEnabled && !timerRunning) {
                                carouselTimer = setInterval(nextSlide, 8000); // 5 seconds
                                timerRunning = true
                            }
                        }

                        function stopCarouselTimer() {
                            timerRunning = false;
                            clearInterval(carouselTimer);
                        }

                        // Start the timer when the page loads
                        document.addEventListener('DOMContentLoaded', function() {
                            // Calculate total slides based on indicators
                            const carouselIndicators = document.getElementById('carouselIndicators');
                            if (carouselIndicators) {
                                const indicators = carouselIndicators.querySelectorAll('.carousel-indicator');
                                totalSlides = indicators.length;
                            }
                            
                            showSlide(1, false); // Show first slide
                            startCarouselTimer(); // Start auto-advance
                        });

                        // Pause auto-advance when hovering over carousel
                        document.addEventListener('DOMContentLoaded', function() {
                            const carouselContainer = document.querySelector('.group');
                            if (carouselContainer) {
                                carouselContainer.addEventListener('mouseenter', stopCarouselTimer);
                                carouselContainer.addEventListener('mouseleave', function() {
                                    if (autoAdvanceEnabled) {
                                        startCarouselTimer();
                                    } 
                                });
                            }
                        });
                    </script>
                </div>
                <!-- Gradient background effect -->
                <div
                    class="absolute inset-4 bg-gradient-to-br from-primarycol to-secondarycol rounded-2xl -z-10 opacity-20">
                </div>
            </div>
        </div>
    </div>
</section>