
<section id="about" class="py-16 bg-base-100">
    <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div class="relative">
                @* <Image
                  src={aboutHero}
                  alt="Rosie Taylor working on brand design"
                  class="rounded-2xl shadow-lg w-full"
                /> *@
                <!-- Placeholder for image -->
                <div class="w-full h-96 bg-gradient-to-br from-primarycol/20 to-secondarycol/20 rounded-2xl shadow-lg flex items-center justify-center">
                    <span class="text-muted-foreground">About Image</span>
                </div>
                <!-- Gradient background effect -->
                <div class="absolute inset-4 bg-gradient-to-tl from-primarycol to-secondarycol rounded-2xl -z-10 opacity-20"></div>
            </div>

            <div class="space-y-8">
                <div class="space-y-4">
                    <h2 class="text-4xl font-bold">
                        Personal branding that 
                        <span class="bg-gradient-to-r from-primarycol to-secondarycol bg-clip-text text-transparent">
                            tells your story
                        </span>
                    </h2>
                    <p class="text-lg text-muted-foreground leading-relaxed">
                        I believe every small business has a unique story worth telling. My approach is deeply personal - 
                        I take the time to understand your business goals, values, and vision before crafting a brand 
                        identity that truly represents who you are.
                    </p>
                </div>

                <div class="space-y-6">
                    <div class="flex gap-4">
                        <div class="flex-shrink-0">
