<!-- Skip link for keyboard navigation -->
<a href="#main-content-themes" 
   class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 
          bg-primarycol text-white px-4 py-2 rounded z-50 
          focus:outline-none focus:ring-2 focus:ring-primarycol focus:ring-offset-2">
    Skip to main content
</a>

<section class="relative flex justify-center 
                bg-gradient-to-b from-base-100 to-base-300 pt-16" 
            aria-labelledby="page-title" 
            aria-describedby="page-description">
    
    <div class="container mx-auto px-4 py-20">
        <!-- Page header with proper semantic structure -->
        <header id="main-content-themes" class="text-center mb-12">
            <!-- Main page title - only one h1 per page -->
            <h1 id="page-title" 
                class="text-4xl md:text-5xl font-bold text-foreground mb-4 
                        focus:outline-none" 
                tabindex="-1">
                Create a 
                <span class="bg-gradient-to-br from-primarycol to-secondarycol bg-clip-text text-transparent">
                    Theme
                </span>
            </h1>
            
            <!-- Subtitle using h2 for proper hierarchy -->
            <h2 class="text-xl md:text-2xl font-medium text-muted-foreground mb-6">
                Customize Your Brand Colors and Design
            </h2>
            
            <!-- Descriptive text with proper ID for aria-describedby -->
            <p id="page-description" 
                class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed mb-8">
                Design a unique theme that reflects your brand identity. Choose colors, 
                customize components, and create a cohesive visual experience for your website.
            </p>
        </header>
        
        <!-- Main content area -->
        <div class="flex flex-row gap-12 items-center justify-center min-w-screen " 
                role="region" 
                aria-label="Theme customization tools">
            
            <!-- Theme preview section -->
            @foreach (dynamic theme in themes)
            {
                <div class="w-60 h-80 p-4 grid row-span-7 grid-rows-subgrid rounded-lg relative
                                border border-2 border-primarycol  
                                bg-card text-card-foreground shadow-lg 
                                hover:ring-secondarycol hover:border-secondarycol transition-all duration-300
                                cursor-pointer"
                                onclick="window.themeToggle?.setTheme('@theme.ThemeName')">
                    <div class="grid row-span-4 grid-rows-subgrid text-center">
                        <div class="w-12 h-12 mt-2 bg-card border border-border-muted rounded-full flex items-center justify-center mx-auto mb-2">
                            <svg class="w-6 h-6 @theme.IconColor" fill="currentColor" viewBox="0 0 24 24">
                                @((MarkupString)theme.Icon)
                            </svg>
                        </div>
                        <div class="mt-2 text-3xl font-bold text-primarycol">@theme.Name</div>
                        <h3 class=" mt-2 font-semibold tracking-tight text-2xl">@theme.Subtitle</h3>
                        <p class="text-sm text-muted-foreground">@theme.Description</p>
                    </div>
                </div>
            }
            
        </div>
    </div>
</section>

    