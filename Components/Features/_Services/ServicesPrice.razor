<div class="min-h-screen sm:px-6 lg:px-8">
    <section class="py-20 px-4 ">
        <div class="max-w-[70%] mx-auto text-center ">
            <h1 class="text-4xl md:text-5xl font-bold mb-8">Choose Your <span
                    class="bg-gradient-to-r from-primarycol to-secondarycol bg-clip-text text-transparent">Perfect
                    Package</span></h1>
            <p class="text-xl text-muted-foreground mx-auto mb-12">Each package is carefully
                crafted to meet different business needs and budgets. All include my personal attention and
                collaborative approach.</p>
        </div>
    </section>
    <section class="py-12 px-4">
        <div class="block lg:hidden max-w-7xl mx-auto">
            <div class="grid grid-cols-1 xl:grid-cols-[repeat(auto-fill,minmax(350px,1fr))] grid-rows-[auto] gap-6">
                @foreach (dynamic service in ServiceList)
                {
                <div class="grid row-span-7 grid-rows-subgrid rounded-lg border bg-card text-card-foreground shadow-sm relative ring-2 ring-primarycol hover:shadow-xl transition-all duration-300">
                    <div class="grid row-span-4 grid-rows-subgrid text-center">
                        <div class="w-16 h-16 mt-5 bg-gradient-to-r from-primarycol to-secondarycol rounded-full flex items-center justify-center mx-auto mb-4">
                            <MudIcon Icon="@service.icon" Class="h-8 w-8" />
                        </div>
                        <h3 class=" mt-2 font-semibold tracking-tight text-2xl">@service.name</h3>
                        <div class="mt-2 text-3xl font-bold text-brand-pink">@service.price</div>
                        <p class="text-sm text-muted-foreground">@service.duration</p>
                    </div>
                    <div class="grid row-span-2 grid-rows-subgrid p-6 pt-6">
                        <p class="text-muted-foreground mb-6">@service.description</p>
                        <ul class="space-y-3 mb-8">
                            @foreach (dynamic feature in service.features)
                            {
                                @if(feature.name != "")
                                {
                                    <h5 class="text-lg font-semibold mb-2">@feature.name</h5>
                                }
                                @foreach (dynamic featureitem in feature.featurelist)
                                {
                                    <li class="flex items-start space-x-3">
                                        <span class="text-secondarycol">
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Class="h-5 w-5 mt-0.5 flex-shrink-0" />
                                        </span>
                                        <span class="text-sm">@featureitem</span>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    <div class="grid row-span-1 grid-rows-subgrid p-6 pt-0">
                        <a class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primarycol text-white hover:shadow-lg hover:scale-105 transition-all duration-300 h-11 rounded-md px-8 w-full"
                            href="/contact">Get a Quote</a>
                    </div>
                </div>
                }
            </div>
        </div>
        <div class="hidden lg:block max-w-7xl mx-auto">
            <div class="grid grid-cols-1 xl:grid-cols-[repeat(auto-fill,minmax(350px,1fr))] grid-rows-[auto] gap-6">
                @foreach (dynamic service in ServiceListDetailed)
                {
                <div class="grid row-span-7 grid-rows-subgrid rounded-lg border bg-card text-card-foreground shadow-[0_0_15px_rgba(0,0,0,0.1)] relative ring-2 ring-primarycol hover:ring-secondarycol hover:shadow-[0_0_15px_rgba(0,0,0,0.5)] transition-all duration-300">
                    <div class="grid row-span-4 grid-rows-subgrid text-center">
                        <div class="w-16 h-16 mt-5 bg-gradient-to-r from-primarycol to-secondarycol rounded-full flex items-center justify-center mx-auto mb-4">
                            <MudIcon Icon="@service.icon" Class="h-8 w-8" />
                        </div>
                        <h3 class=" mt-2 font-semibold tracking-tight text-2xl">@service.name</h3>
                        <div class="mt-2 text-3xl font-bold text-brand-pink">@service.price</div>
                        <p class="text-sm text-muted-foreground">@service.duration</p>
                    </div>
                    <div class="grid row-span-2 grid-rows-subgrid p-6 pt-6">
                        <p class="text-muted-foreground mb-6">@service.description</p>
                        <ul class="space-y-3 mb-8">
                            @foreach (dynamic feature in service.features)
                            {
                                @if(feature.name != "")
                                {
                                    <h5 class="text-lg font-semibold mb-2">@feature.name</h5>
                                }
                                @foreach (dynamic featureitem in feature.featurelist)
                                {
                                    <li class="flex items-start space-x-3">
                                        <span class="text-secondarycol">
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Class="h-5 w-5 text-secondarycol mt-0.5 flex-shrink-0" />
                                        </span>
                                        <span class="text-sm">@featureitem</span>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    <div class="grid row-span-1 grid-rows-subgrid p-6 pt-0">
                        <a class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primarycol text-white hover:shadow-lg hover:scale-105 transition-all duration-300 h-11 rounded-md px-8 w-full"
                            href="/contact">Get a Quote</a>
                    </div>
                </div>
                }
            </div>
        </div>
    </section>
</div>